# URL of the deployed frontend - used to build shareable invite links.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for preview deployments. Unset by default, since a wildcard
# over vercel.app trusts any tenant. Anchor it to your own project.
#CORS_ORIGIN_REGEX=

# "development" (default) or "production". Production refuses to boot without
# a real JWT_SECRET. Render sets RENDER=true, which implies production.
APP_ENV=development

# Sample meetings, hosted by the first account that exists. Opt in.
SEED_SAMPLE_DATA=false

# Demo logins that skip the OTP flow. Both required, no default password,
# because a password in this repository is a public credential.
SEED_DEMO_ACCOUNTS=false
DEMO_PASSWORD=

# --- Database -------------------------------------------------------------
# Neon's POOLED connection string (the host contains "-pooler"). Required in
# production; the app refuses to boot without it rather than silently falling
# back to a SQLite file on an ephemeral disk.
# Leave blank locally to use ./parley.db instead - fine for an offline test
# run, but local development should point at a Neon dev branch so migrations
# are exercised against the dialect that actually ships.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Connection pool. Defaults suit Render's free tier (a single instance).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Below Neon's ~5 minute idle scale-to-zero, so connections are recycled
# before they can go stale.
DB_POOL_RECYCLE=280

# --- Auth -----------------------------------------------------------------
# Signs JWTs. Required in production and at least 32 characters there. Blank
# locally uses a development default and logs a warning.
JWT_SECRET=
# The upper bound on a stolen token. A password change retires older ones.
JWT_EXPIRE_HOURS=12

# --- Email / OTP (signup verification codes) ------------------------------
# To ACTUALLY send email, set BOTH SMTP_USER (the sending mailbox) and
# SMTP_PASS (for Gmail, an *App Password*: Google Account > Security > 2-Step
# Verification > App Passwords - a 16-char code, NOT your login password).
# Leave either blank for dev mode, where the OTP is shown and logged. In
# production that path is refused, so signup returns 503 and everything else
# keeps working. Use a dedicated mailbox, not a personal one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Parley
OTP_TTL_MINUTES=10
# Wrong codes allowed before the pending signup is discarded.
OTP_MAX_ATTEMPTS=5
# Seconds to wait on the SMTP socket before giving up.
SMTP_TIMEOUT=15

# --- WebRTC ICE -----------------------------------------------------------
# Served to the browser by GET /api/ice rather than baked into the frontend
# bundle, so rotating a credential is an environment change, not a rebuild.
# These are not secrets: they reach the browser by construction.
#
# Comma-separated. PASTE TURN URLS IN DIRECTLY, NEVER THROUGH A SHELL - the
# "?" in "?transport=tcp" is a glob metacharacter, and a value that loses it
# makes new RTCPeerConnection THROW rather than degrade. That took video down
# in production once already.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# The defaults below are Open Relay's public endpoint, kept as a placeholder
# that documents the shape. It is measured non-functional - it refuses every
# allocation - so set these to a real account to actually get a relay.
# Left commented so the code defaults (and the boot warning above) apply.
# Uncomment and fill in for a real relay account.
#TURN_URLS=turn:HOST:80,turn:HOST:443,turns:HOST:443?transport=tcp
#TURN_USERNAME=
#TURN_CREDENTIAL=
# Candidates pre-gathered per peer connection.
ICE_CANDIDATE_POOL_SIZE=2

# --- Media plane ----------------------------------------------------------
# ROOM_CAP is the number the server refuses to seat past, enforced on both the
# join endpoint and the websocket. It is measured, not guessed: 10 is the last
# rung with CPU and bandwidth headroom on a 20-core i7-12700H. See the README.
ROOM_CAP=10
# How many remote cameras one client subscribes to at once.
VIDEO_BUDGET=5

# --- Logging --------------------------------------------------------------
# "json" (one object per line) or "text". Left unset it defaults to json in
# production and text locally, which is what you want; an EMPTY value is not
# the same as unset and would force text everywhere.
#LOG_FORMAT=
LOG_LEVEL=INFO
