# URL of the deployed frontend - used to build shareable invite links.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# "development" (default) or "production". Production refuses to boot without
# a real JWT_SECRET. Render sets RENDER=true, which implies production.
APP_ENV=development

# Three demo accounts (password demo1234) are always seeded on startup so the
# app can be tested without the OTP flow. Set this to true to ALSO seed a few
# sample meetings hosted by the first demo account.
SEED_SAMPLE_DATA=false

# --- Database -------------------------------------------------------------
# Neon's POOLED connection string (the host contains "-pooler"). Required in
# production; the app refuses to boot without it rather than silently falling
# back to a SQLite file on an ephemeral disk.
# Leave blank locally to use ./parley.db instead - fine for an offline test
# run, but local development should point at a Neon dev branch so migrations
# are exercised against the dialect that actually ships.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Connection pool. Defaults suit Render's free tier (a single instance).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Below Neon's ~5 minute idle scale-to-zero, so connections are recycled
# before they can go stale.
DB_POOL_RECYCLE=280

# --- Auth ---
# Secret used to sign JWTs. Required in production; a long random string.
# Left blank locally, a development default is used and a warning is logged.
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# --- Email / OTP (signup verification codes) ---
# To ACTUALLY send email, set BOTH SMTP_USER (the sending mailbox) and
# SMTP_PASS (for Gmail, an *App Password*: Google Account > Security > 2-Step
# Verification > App Passwords - a 16-char code, NOT your login password).
# Leave either blank to run in dev mode (the OTP is shown in the UI + logged).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Parley
OTP_TTL_MINUTES=10
# Seconds to wait on the SMTP socket before giving up.
SMTP_TIMEOUT=15
